{
  "manifest_version": 3,
  "name": "Chess Hint Assistant",
  "version": "9.0.0",
  "minimum_chrome_version": "114",
  "description": "Cloud chess coach with exact-move hints, three playing styles, Human-like mode, multi-source analysis, opening explorer, and tablebases.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*",
    "https://lichess.org/*",
    "https://lichess.org/api/*",
    "https://explorer.lichess.ovh/*",
    "https://tablebase.lichess.ovh/*",
    "https://chess-api.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open Chess Hint Assistant",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel/*",
        "icons/*",
        "engine/eco.json"
      ],
      "matches": [
        "https://*.chess.com/*",
        "https://*.lichess.org/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://lichess.org https://explorer.lichess.ovh https://tablebase.lichess.ovh https://chess-api.com;"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
